{
  "name": "@ad-daddy/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./campaign": {
      "types": "./dist/commands/campaign.d.ts",
      "default": "./dist/commands/campaign.js"
    },
    "./opportunity": {
      "types": "./dist/commands/opportunity.d.ts",
      "default": "./dist/commands/opportunity.js"
    }
  },
  "bin": {
    "ad-daddy": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@ad-daddy/host-adapters": "0.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
